# ── API Keys ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here
FITSCAN_API_KEY_SECRET=generate_with_secrets_token_hex_32

# ── Auth ──────────────────────────────────────────────
# Production must leave this on (default true). In tests set false to skip auth.
FITSCAN_REQUIRE_API_KEY=true

# Shared secret for /api/v1/admin/* endpoints (Celery health, usage stats,
# /keys/register). Must match the Nidlo backend's stored value — generate
# via the admin UI at /admin/system/fitscan-integration and propagate
# here via `python -m fitscan.cli set-admin-key <KEY>` or by editing this
# file directly + restarting Fitscan.
FITSCAN_ADMIN_API_KEY=

# DEV-ONLY bypass — when "true", admin endpoints trust loopback callers
# (127.0.0.1 / localhost / ::1) WITHOUT the X-Admin-API-Key header.
# Lets you wire the admin dashboard against a local Fitscan instance
# without doing the shared-secret dance. Production MUST keep this off
# (default false).
FITSCAN_ALLOW_UNAUTHED_LOCALHOST=false

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://fitscan:password@localhost:5432/fitscan_dev
TEST_DATABASE_URL=postgresql://fitscan:password@localhost:5432/fitscan_test

# ── Object Storage (MinIO locally / S3 in prod) ───────
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fitscan-avatars
S3_BUCKET=fitscan-avatars
S3_REGION=us-east-1

# ── Queue ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── ML Models ─────────────────────────────────────────
SMPL_MODEL_PATH=data/models/smpl/SMPL_NEUTRAL.pkl
HMR2_CHECKPOINT_PATH=data/models/hmr2/epoch=35-step=1000000.ckpt

# ── Feature Flags ─────────────────────────────────────
ENABLE_CLAUDE_VALIDATION=true
ENABLE_SMPL_FITTING=true
ENABLE_AVATAR_GENERATION=true
CONFIDENCE_THRESHOLD=0.65
MAX_IMAGE_SIZE_MB=10

# ── Server ────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# ── SaaS ──────────────────────────────────────────────
FREE_TIER_MONTHLY_LIMIT=50
PRO_TIER_MONTHLY_LIMIT=1000
STRIPE_SECRET_KEY=sk_test_...

# ── Email (Resend) — FS-NIDLO-NOTIF-01 ──────────────
# Leave RESEND_API_KEY empty in dev / CI — ResendClient no-ops without
# a key. Production deploys must set this to a Resend key whose verified
# domain matches RESEND_FROM_ADDRESS. Fitscan has its own sender
# identity separate from the backend so DKIM lineage stays clean.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@nidlo.test
RESEND_FROM_NAME=Nidlo Fitscan
